<!-- STATIC PLAY OFF V2.1 HTML/CSS SOURCE PART 02B. NO CREDENTIALS, TOKENS, AUTH KEYS, OR USER SAVE DATA. BUILD SCRIPT REMOVES THIS HEADER. -->
.finalsSeriesPanel{background:linear-gradient(135deg,#fff8e9,#fff3f8 48%,#eef9ff);border-color:#efdcb8}.seriesSummary{font-weight:900;color:#755d69;margin-bottom:10px;line-height:1.6}.seriesScroll{overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px}.seriesGrid{display:grid;grid-template-columns:repeat(7,minmax(128px,1fr));gap:9px;min-width:920px}.seriesGame{background:#fff;border:1px solid #eadfe8;border-radius:14px;padding:10px;min-height:112px;display:flex;flex-direction:column;gap:6px}.seriesGame .gno{font-weight:950;color:#79687a}.seriesGame .seriesScore{font-size:18px;font-weight:950;color:#d06a80}.seriesGame .seriesStatus{font-size:11px;color:#8e7e8d;line-height:1.45}.seriesGame.played{background:#fffdf8}.seriesGame.next{background:#eaf7ff;border:2px solid #75b7ef;box-shadow:0 7px 18px rgba(117,183,239,.18)}.seriesGame.next .gno{color:#367fb5}.seriesGame.optional{background:#f7f5f7;border-style:dashed;color:#9b9099}.seriesGame.optional .seriesScore{font-size:13px;color:#9b9099}.seriesGame.champ{background:#eefbf3;border-color:#bfe5cf}.opsPlus{font-weight:900;color:#6d5b87}
.lobbyPrimaryInfo{min-width:0;flex:1 1 auto}.lobbyRecordTeamRow{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:3px 0}.lobbyTeamIdentity{min-width:0}.lobbyTeamNameCrest{display:flex;align-items:center;gap:9px;min-width:0}.lobbyTeamSide{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:flex-end}.lobbyTeamName{font-size:clamp(34px,5.5vw,48px);line-height:1.15;font-weight:950;color:#d06a80;background:#fff7fb;border:1px solid #f0dfe8;border-radius:14px;padding:7px 12px;box-shadow:0 5px 14px rgba(208,106,128,.10);overflow-wrap:anywhere}.lobbyCrest{font-size:clamp(28px,4vw,38px);line-height:1;flex:0 0 auto}.pregameOpponent,.pregameStarter{font-size:clamp(19px,2.6vw,24px);font-weight:950;color:#5b4a5d}
.teamRecent10{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.recentTeamGame{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fffafd;border:1px solid #eadfe8;border-radius:12px;padding:9px 11px}.recentTeamGame.win{background:#eefbf3;border-color:#cfead9}.recentTeamGame.loss{background:#fff4f5;border-color:#f0d7db}.recentTeamGame .recentNo{font-weight:950;min-width:24px;color:#86778a}.recentTeamGame .wl{font-weight:950;min-width:24px}.recentTeamGame.win .wl{color:#3e9b6b}.recentTeamGame.loss .wl{color:#d15f6f}.recentTeamGame .opponent{min-width:0;overflow-wrap:anywhere}.recentTeamGame .rscore{font-weight:900;white-space:nowrap;color:#6e5b70}

/* 平板 */
@media(max-width:980px){
  .wrap{padding:14px}.metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.strategyGrid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid2,.lineups{grid-template-columns:1fr}.hero{padding:20px}table{min-width:820px}
}

/* 手機 */
@media(max-width:640px){
  body{padding-bottom:env(safe-area-inset-bottom)}
