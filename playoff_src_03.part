<!-- STATIC PLAY OFF V2.1 HTML/CSS SOURCE PART 03. NO CREDENTIALS, TOKENS, AUTH KEYS, OR USER SAVE DATA. BUILD SCRIPT REMOVES THIS HEADER. -->
.crest{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#fff;border:2px solid #eadfe8;box-shadow:0 3px 8px rgba(110,90,105,.10);font-size:18px;vertical-align:middle;margin-right:6px}.crest.big{width:44px;height:44px;font-size:25px}.logoChooser{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.logoOption{width:46px;height:46px;min-height:46px;padding:0;border-radius:50%;background:#fff;border:2px solid #eadfe8;color:#554958;font-size:24px;box-shadow:none}.logoOption.selected{border-color:#7aa7ff;box-shadow:0 0 0 3px rgba(122,167,255,.18);background:#f0f7ff}.budgetTools{display:flex;align-items:flex-end;justify-content:flex-end;gap:8px;flex-wrap:wrap}.respecInfo{font-size:11px;color:#8e7e8d;margin-top:5px;text-align:right}.magic{font-weight:950;color:#d07849;background:#fff1da;border-radius:999px;padding:3px 7px;display:inline-block}.clickGame{width:100%;text-align:left;background:#fff;color:var(--text);box-shadow:none;border:1px solid #eadfe8;min-height:0}.clickGame:hover{background:#fffafd}.scheduleBtnWrap{text-align:center;margin-top:14px}.calendar{min-width:1050px;border-collapse:separate;border-spacing:8px;background:transparent}.calendar th{position:static;background:#f9f1f6;border:0;border-radius:12px;padding:10px}.calendar td{vertical-align:top;white-space:normal;border:1px solid #eadfe8;border-radius:14px;background:#fff;padding:9px;min-width:140px;height:150px}.calendar .rest{background:#f6f3f6;color:#9c919b;text-align:center}.calendar .dayNo{font-weight:950;margin-bottom:6px;color:#6d5e70}.calGame{display:block;border-top:1px dashed #eadfe8;padding:5px 0;font-size:11px;line-height:1.45}.calGame:first-of-type{border-top:0}.calGame.played{cursor:pointer}.calGame .calScore{font-weight:950;color:#d16e83}.boxGrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}.boxCard{background:#fff;border:1px solid #eadfe8;border-radius:14px;padding:10px;min-width:0}.boxCard h3{display:flex;align-items:center;gap:6px}.boxTable{min-width:720px;font-size:12px}.npNow{display:inline-block;margin-left:7px;color:#5b7290;background:#eef6ff;border:1px solid #d7e8fa;border-radius:7px;padding:0 6px;font-weight:800}.tie{background:#f5f3ff;border-color:#ded8f5}.recentTeamGame.tie .wl{color:#786aa4}.mvpBadge{font-weight:900;color:#a36c16}.teamHeaderLine{display:flex;align-items:center;gap:7px}.scheduleHero{background:linear-gradient(135deg,#eef9ff,#fff3f8,#f4fff7)}.strikeoutText{color:#173f78;font-weight:400}.doublePlayText{color:#173f78;font-weight:950}.sacrificeText{color:#69a9d6;font-weight:400}.halfScoreHot{color:#d94f5c;font-weight:950}.finalCall{display:block;color:#111;font-size:clamp(18px,2.5vw,25px);font-weight:400;line-height:1.55;margin:12px 0 4px}.finalTeamName{color:#4f72b8}.finalDiff{color:#d26484;font-weight:400}.totalRow td{font-weight:900;background:#fffaf1;border-top:2px solid #eadfe8}.lineupTotals{margin-top:9px;padding-top:8px;border-top:1px dashed #eadfe8;font-size:12px;font-weight:900;color:#6d5e70}
@media(max-width:760px){.boxGrid{grid-template-columns:1fr}.budgetTools{justify-content:flex-start}.respecInfo{text-align:left}.calendarWrap{overflow-x:auto}.logoChooser{justify-content:flex-start}}


.playoffHero{position:relative;overflow:hidden;background:linear-gradient(135deg,#1c2440,#40294c 52%,#182d43);color:#fff;border-color:#6d6585;box-shadow:0 14px 34px rgba(44,35,70,.22)}
.playoffHero::after{content:"PLAY OFF";position:absolute;right:-10px;bottom:-22px;font-size:clamp(64px,12vw,140px);font-weight:950;letter-spacing:.06em;color:rgba(255,255,255,.055);pointer-events:none}.playoffHero .muted,.playoffHero #lobbyManagerName{color:#d9d4e7}.playoffHero .bigRecord{color:#fff}.playoffHero .lobbyTeamName{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.18);color:#fff;box-shadow:none}.playoffHero #lobbyPct{color:#ffe0a8}.playoffHero .pregameBox{background:rgba(255,255,255,.10);border-color:rgba(255,255,255,.15);color:#fff;position:relative;z-index:1}
.playoffBoard{background:linear-gradient(160deg,#f9f6ff,#fffaf3 48%,#f3f9ff)}.playoffRoad{display:grid;grid-template-columns:minmax(0,1fr) 58px minmax(0,1fr);gap:12px;align-items:stretch}.roadArrow{display:flex;align-items:center;justify-content:center;font-size:32px;color:#9c8aa2}.seriesStage{position:relative;background:#fff;border:1px solid #e6dbe7;border-radius:18px;padding:16px;box-shadow:0 8px 20px rgba(95,75,105,.08);overflow:hidden}.seriesStage.active{border:2px solid #7fa8db;box-shadow:0 10px 24px rgba(95,136,190,.18)}.seriesStage.locked{opacity:.66;filter:saturate(.75)}.seriesStage.cleared{background:linear-gradient(145deg,#fffdf4,#f4fff8);border-color:#d9d5a8}.stageEyebrow{font-size:11px;letter-spacing:.14em;color:#9a879c;font-weight:900}.stageTitle{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:7px 0}.stageTitle h2{margin:0}.seriesScoreBig{font-size:clamp(28px,4vw,40px);font-weight:950;color:#594f62}.seriesRule{font-size:12px;color:#8d7d8c}.stageTrophy.small{font-size:36px;filter:drop-shadow(0 4px 5px rgba(176,130,38,.18))}.stageTrophy.big{display:block;text-align:center;font-size:82px;line-height:1;margin:5px 0;filter:drop-shadow(0 8px 9px rgba(176,130,38,.24))}.seriesMiniGrid{display:grid;grid-template-columns:repeat(7,minmax(62px,1fr));gap:6px;margin-top:13px}.seriesMiniGrid.five{grid-template-columns:repeat(5,minmax(62px,1fr))}.miniGame{background:#faf7fb;border:1px solid #eadfe8;border-radius:10px;padding:7px;text-align:center;min-height:64px}.miniGame .g{font-size:10px;color:#8d7f8f;font-weight:900}.miniGame .s{font-size:16px;font-weight:950;color:#d06a80;margin-top:4px}.miniGame.win{background:#effbf3;border-color:#c8e7d4}.miniGame.loss{background:#fff2f2;border-color:#efd1d1}.miniGame.next{background:#eef7ff;border:2px solid #8bbce6}.miniGame.unplayed{color:#aaa}.champBanner{margin-top:14px;padding:16px;border-radius:18px;text-align:center;background:linear-gradient(135deg,#fff6d7,#fffdf6,#f1fff7);border:1px solid #ead79a}.champBanner h2{margin:4px 0;color:#856a24}.playoffHistory{display:grid;gap:8px;margin-top:12px}.playoffHistory .gameChip{background:#fff}
.teamSummaryLayout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.8fr);gap:14px;align-items:stretch}.teamSummaryLayout .metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.radarCard{background:linear-gradient(145deg,#fbf8ff,#f8fcff);border:1px solid #e9deec;border-radius:16px;padding:12px;display:flex;flex-direction:column;justify-content:center}.radarTitle{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:3px}.radarTitle b{color:#5f5365}.radarLegend{font-size:10px;color:#9a8b9c}.radarSvg{width:100%;height:auto;max-height:265px;display:block}.radarGrid{fill:none;stroke:#ded5e4;stroke-width:1}.radarAxis{stroke:#e5dce8;stroke-width:1}.radarShape{fill:rgba(103,151,213,.20);stroke:#678fca;stroke-width:2}.radarDot{fill:#678fca}.radarLabel{font-size:10px;fill:#6d6170;font-weight:700}.radarGrade{font-size:12px;fill:#4c6383;font-weight:950}.radarCenterNote{text-align:center;font-size:11px;color:#8d7f90;margin-top:2px}
.playerTeamMark{color:#315f9b!important;text-decoration:underline;text-decoration-color:#a9c6e8;text-underline-offset:2px}.playerOffenseLine{background:linear-gradient(90deg,rgba(212,235,255,.55),rgba(255,255,255,0));border-left:3px solid #9ec6e9;padding-left:6px;margin-left:-6px;display:block}.playerLineup{box-shadow:inset 0 0 0 2px rgba(116,166,218,.16);background:#f8fcff}
@media(max-width:760px){.playoffRoad{grid-template-columns:1fr}.roadArrow{transform:rotate(90deg);min-height:24px}.teamSummaryLayout{grid-template-columns:1fr}.teamSummaryLayout .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.seriesMiniGrid,.seriesMiniGrid.five{grid-template-columns:repeat(3,minmax(66px,1fr))}}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
</style>
</head>

