<!-- STATIC PLAY OFF V2.1 HTML/CSS SOURCE PART 02C. NO CREDENTIALS, TOKENS, AUTH KEYS, OR USER SAVE DATA. BUILD SCRIPT REMOVES THIS HEADER. -->
  .wrap{padding:10px 10px 18px}.panel{padding:13px;border-radius:16px;margin-bottom:12px}.hero{padding:15px}.topBrand{align-items:flex-start;padding:12px 13px;border-radius:16px;margin-bottom:12px}.topBrand>span{flex:0 0 auto}
  .tagline{font-size:11px}.toolbar.spread{align-items:stretch}.hero .toolbar.spread{flex-direction:column}.hero .toolbar.spread button{width:100%}
  .grid2{gap:12px}.metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.teamRecent10{grid-template-columns:1fr}.lobbyRecordTeamRow{align-items:center;gap:9px;flex-wrap:wrap}.lobbyTeamIdentity{flex:0 1 auto;min-width:0}.lobbyTeamNameCrest{justify-content:flex-start}.lobbyTeamName{text-align:left;width:auto;max-width:min(58vw,280px)}.lobbyTeamSide{justify-content:stretch}.lobbyTeamSide button{width:100%}.metric{padding:10px}.strategyGrid{grid-template-columns:1fr;gap:9px}
  button{min-height:44px;padding:10px 13px}select,input{min-height:44px;font-size:16px}.xlBtn{min-height:56px;font-size:18px;width:100%}
  .teamName{width:100%;max-width:100%;margin-top:3px}.managerNameInput{width:min(220px,70vw)}.toolbar.spread>div{flex:1 1 100%;min-width:0}.toolbar.spread>div[style*="min-width:230px"]{min-width:0!important;width:100%}
  .tableWrap{border-radius:12px;margin-inline:0}table{font-size:13px;min-width:860px}th,td{padding:8px 6px}.ratingCtl{gap:5px}.ratingCtl select{min-width:72px;min-height:40px;font-size:16px;padding-block:6px}
  .batOrderSelect,.positionSelect{min-width:76px;min-height:40px;font-size:16px;padding:5px}.nameInput{font-size:16px!important;min-height:40px!important}
  .pregameBox{font-size:14px}.lineupCard{padding:9px}.lineupCard>div{font-size:13px;gap:8px}.teamPreStats{font-size:12px!important}.diceBanner{font-size:13px}
  .broadcast{padding:12px;min-height:320px;font-size:13px;line-height:1.85;border-radius:13px}.scoreNow{margin-left:4px;padding:1px 5px;font-size:12px}.baseState{margin:0 2px;transform:scale(.92);transform-origin:center}
  .finalScore{line-height:1.35}.scoreTable{min-width:700px}.bottomActions{justify-content:stretch}.bottomActions button{width:100%;min-height:50px}
  .gameChip{align-items:flex-start;flex-direction:column;padding:9px}.gameChip .score{align-self:flex-end}.cuteBox{padding:11px}
}

/* 極窄手機 */
@media(max-width:390px){
  .wrap{padding-inline:8px}.panel{padding:11px}.topBrand h1{font-size:20px}.topBrand>span.small{font-size:10px}.metrics{grid-template-columns:1fr 1fr}.metric span{font-size:11px}.metric b{font-size:16px}
  .broadcast{font-size:12.5px;padding:10px}.baseState{transform:scale(.86);margin-inline:0}.scoreNow{display:inline;margin-left:2px;line-height:1.8}
}

/* 橫向手機：善用寬度 */
@media(max-height:520px) and (orientation:landscape){
  .wrap{padding-top:8px}.panel{margin-bottom:10px}.topBrand{padding-block:9px}.lineups{grid-template-columns:1fr 1fr}.broadcast{min-height:220px}
}


