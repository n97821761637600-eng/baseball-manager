<!-- STATIC PLAY OFF V2.1 HTML/CSS SOURCE PART 02A. NO CREDENTIALS, TOKENS, AUTH KEYS, OR USER SAVE DATA. BUILD SCRIPT REMOVES THIS HEADER. -->
  overflow-wrap:anywhere;word-break:break-word;font-size:14px
}
.baseState{display:inline-block;position:relative;width:46px;height:32px;vertical-align:middle;margin:0 5px;flex:0 0 auto}.baseMarker{position:absolute;width:11px;height:11px;transform:rotate(45deg);background:#fff;border:1px solid #cfc6cc;box-shadow:0 0 0 1px rgba(0,0,0,.05)}.baseMarker.on{background:var(--red);border-color:#e35f5c}.baseMarker.b2{top:1px;left:17px}.baseMarker.b3{top:17px;left:5px}.baseMarker.b1{top:17px;right:5px}
.result{margin-top:18px;border:1px solid #d5eadf;background:#f4fff8}.finalScore{font-size:clamp(24px,4vw,31px);font-weight:950;text-align:center;margin:10px 0 15px;color:#4f6e5d;overflow-wrap:anywhere}.scoreTable{font-size:13px;min-width:720px}.scoreTable th,.scoreTable td{min-width:36px;padding:7px 5px}
.bottomActions{display:flex;justify-content:flex-end;margin-top:18px;padding-bottom:max(8px,env(safe-area-inset-bottom))}.diceBanner{padding:10px 12px;background:#f2edff;border:1px solid #e0d7f7;border-radius:11px;margin-bottom:14px;color:#665b82;line-height:1.6}.backLink{background:#a99bb0}
.cuteBox{background:linear-gradient(145deg,#fffafd,#f6fbff);border:1px solid #eadfe8;border-radius:15px;padding:13px;min-width:0}.recentList,.nextGamesList{display:grid;gap:8px}.gameChip{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 11px;background:#fff;border:1px solid #eadfe8;border-radius:12px;min-width:0}.gameChip>span:first-child{min-width:0;overflow-wrap:anywhere}.gameChip b{color:#5e5261}.gameChip .score{font-weight:900;color:#d16e83;white-space:nowrap}.playerGame{background:#eefbf3;border-color:#cfead9}.weakHint{font-size:11px;color:#a48c9d}.gbCell{font-weight:800;color:#8b6b86}
